# ─────────────────────────────────────────────────────────────
# PANNA LEAGUE AI COMMAND CENTER — Environment Configuration
# ─────────────────────────────────────────────────────────────
# The application runs fully with ZERO keys configured, using the
# built-in Mock AI provider and bundled demo data. Fill these in
# only when you're ready to wire up real integrations.

# App
NEXT_PUBLIC_APP_NAME="Panna League AI Command Center"

# AI mode: "mock" (default, no key needed) or "live"
# When "live" AND ANTHROPIC_API_KEY is set, the app calls the real Claude API
# via lib/ai/providers/claude.ts (already implemented — no code changes
# needed). Falls back to Mock AI automatically if the key is missing.
NEXT_PUBLIC_AI_MODE=mock

# Claude / Anthropic API key — required only when NEXT_PUBLIC_AI_MODE=live.
# Get one at https://console.anthropic.com/settings/keys (new accounts get
# a small free credit grant; beyond that it's pay-per-token, no monthly fee).
# NEVER prefix this with NEXT_PUBLIC_ — it must stay server-side only.
ANTHROPIC_API_KEY=

# Optional: override the model used by lib/ai/providers/claude.ts.
# Defaults to claude-opus-5 if unset. claude-sonnet-5 is cheaper and plenty
# capable for outreach/classification text — see README "Real AI mode" section.
ANTHROPIC_MODEL=claude-opus-5

# Supabase (real database for players/clubs/sponsors — see README §11)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web / company research provider (future integration)
RESEARCH_API_KEY=

# Prospect / contact database (e.g. Apollo-compatible provider)
PROSPECT_API_KEY=

# Google Calendar + Gmail — already implemented (lib/integrations/calendar.ts,
# email.ts). Create an OAuth "Desktop app" client at
# https://console.cloud.google.com/apis/credentials, enable the Calendar API
# and Gmail API, then paste the client id/secret below.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Run `npm run google:auth` locally (opens a one-time Google sign-in) and
# paste the printed refresh token here. Leaving this blank keeps the app on
# mock calendar/email behavior — nothing breaks either way.
GOOGLE_REFRESH_TOKEN=

# CRM sync (e.g. HubSpot / Pipedrive compatible) — optional; the app's own
# Sponsor CRM page already covers this for most use cases, see README §11.
CRM_API_KEY=

# Social media publishing (Content Agent)
INSTAGRAM_API_KEY=
TIKTOK_API_KEY=
LINKEDIN_API_KEY=
YOUTUBE_API_KEY=

# Analytics provider
ANALYTICS_API_KEY=
